# 独立 HTTPS 前置的设置（示例：设备 10.8.0.12 的 HTTP 7778 -> HTTPS 8443）。
# 用法：docker compose --env-file settings.env.example up -d
# compose 从这里读取变量替换，并把下面几项显式传进前置容器的环境变量。
#
# 只填设备本机 / 网关的受信网卡地址；不要留空、不要写 0.0.0.0 对外敞开。

# 浏览器最终访问的 HTTPS 入口 IP 或主机名（裸 IP 也可以）。
# 同时用作证书名与 default_sni，所以必须与浏览器地址栏一致。
NF_HTTPS_PUBLIC_IP=10.8.0.12

# HTTPS 监听端口，宿主机与容器内保持一致。
NF_HTTPS_PORT=8443

# 宿主机上绑定的地址（compose 端口映射左侧）。只填一个受信地址：
# 设备本机网卡、或网关的可信 LAN/VPN 地址。这一步决定谁能连上前置。
NF_HTTPS_HOST_BIND=10.8.0.12

# 前置要访问的设备原 HTTP 服务，必须是设备本机、可信 LAN 或 VPN 内可达的固定地址。
# 网关部署时它与 NF_HTTPS_PUBLIC_IP 可以不同。
NF_HTTP_UPSTREAM_HOST=10.8.0.12
NF_HTTP_UPSTREAM_PORT=7778
