# Used by: docker compose --env-file deploy/.env -f deploy/compose.yaml ...
# Copy to deploy/.env and replace the dedicated hub hostname before starting.
# Production requires HTTPS; each NF must use another hostname, e.g. nf-a.example.net.
PUBLIC_URL=https://hub.example.net

# Inside the private hub-data volume. After an offline restore, select the NEW path here.
DATABASE_PATH=/data/hub.sqlite

# No passwords, pairing codes, tokens or TLS private keys belong in this file/image.
# Initialize the administrator interactively with the init CLI (see sh deploy/hub.sh --help).
