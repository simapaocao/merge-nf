# Production: HTTPS terminates at a trusted reverse proxy; preserve the PUBLIC_URL Host.
PUBLIC_URL=https://hub.example.invalid
BIND_HOST=127.0.0.1
PORT=17900
# Direct HTTPS (both files together), instead of terminating TLS at the proxy:
# TLS_CERT_FILE=/private/path/to/fullchain.pem
# TLS_KEY_FILE=/private/path/to/privkey.pem
# Non-loopback plaintext listener: set TRUSTED_PROXY_IP to the single TLS proxy peer,
# firewall the internal link and keep it on a private, trusted network. Never use forwarded headers as proof of TLS.
DATABASE_PATH=./.data/hub.sqlite
WEB_DIST=./apps/web/dist
# Local-only development: set PUBLIC_URL=http://127.0.0.1:17900 and DEV_HTTP=1.
# Never enable DEV_HTTP in production. Credentials are created by the offline admin CLI.
DEV_HTTP=0
